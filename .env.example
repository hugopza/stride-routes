EXPO_PUBLIC_ORS_API_KEY=your_openrouteservice_api_key
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional (dev only): set to true/1 to allow synthetic fake routes.
EXPO_PUBLIC_ALLOW_FAKE_ROUTES=false
# Optional (dev only): set to true/1 to enable verbose routing debug logs.
EXPO_PUBLIC_DEBUG_ROUTING=false
